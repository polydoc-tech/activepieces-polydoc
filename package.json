{
  "name": "activepieces-polydoc",
  "version": "0.1.3",
  "description": "PolyDoc connector for Activepieces: convert HTML or a URL to PDF, capture screenshots, and generate EU e-invoices (Factur-X / ZUGFeRD).",
  "keywords": [
    "activepieces",
    "activepieces-piece",
    "polydoc",
    "pdf",
    "html-to-pdf",
    "screenshot",
    "e-invoice",
    "factur-x",
    "zugferd"
  ],
  "license": "MIT",
  "homepage": "https://polydoc.tech",
  "author": {
    "name": "PolyDoc",
    "email": "hello@polydoc.tech"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polydoc-tech/activepieces-polydoc.git"
  },
  "bugs": {
    "url": "https://github.com/polydoc-tech/activepieces-polydoc/issues"
  },
  "main": "./dist/src/index.js",
  "engines": {
    "node": ">=18.20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && node scripts/prepare-dist.mjs",
    "prepublishOnly": "npm run build",
    "dev": "tsc -p tsconfig.lib.json --watch",
    "lint": "eslint src",
    "lintfix": "eslint src --fix",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run test/build-request-body.test.ts",
    "test:integration": "vitest run test/integration.test.ts"
  },
  "dependencies": {
    "@activepieces/pieces-common": "0.12.5",
    "@activepieces/pieces-framework": "0.32.0",
    "@activepieces/shared": "0.96.2",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "axios": "^1.20.0",
    "form-data": "^4.0.6",
    "nanoid": "^3.3.18",
    "zod": "^4.6.6"
  }
}
